# Modelo das variáveis de ambiente. Copie para .env.local (que nunca vai para o git)
# ou rode `npm run gerar-chaves`, que cria o .env.local com as chaves aleatórias.
# Este arquivo contém apenas os NOMES das variáveis — nunca coloque valores reais aqui.

# Endereço do banco PostgreSQL: usuário, senha, servidor, porta e nome do banco.
# Formato: postgresql://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO
DATABASE_URL=

# Segredo do login (Better Auth): assina as sessões e protege os códigos do Google Authenticator.
# Se for perdido, todos precisam reconfigurar o autenticador. Guarde uma cópia fora do computador.
BETTER_AUTH_SECRET=

# Endereço público do sistema (em desenvolvimento: http://localhost:3000).
BETTER_AUTH_URL=

# Chave mestra do Cofre (AES-256-GCM, 32 bytes em base64), versão 1.
# Se for perdida, as senhas do Cofre ficam ilegíveis para sempre. Guarde uma cópia fora do computador.
VAULT_ENCRYPTION_KEY_V1=

# Versão da chave do Cofre usada para cifrar novos registros (as antigas continuam decifrando).
VAULT_ACTIVE_KEY_VERSION=

# (Opcional) Tentativas de login e de código por minuto, por endereço. Padrão: 10.
# Só os testes automáticos aumentam este número.
AUTH_SIGNIN_RATE_LIMIT=


