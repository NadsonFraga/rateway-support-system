// Estrutura do banco. Cada mudança aqui vira uma migração (prisma/migrations) aplicada com segurança.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Configurações da instância (white-label): nome, logos e formatos de código vêm daqui, nunca do código.
model InstanceSettings {
  id                     String   @id @default("instancia")
  name                   String
  logoDarkUrl            String?
  logoLightUrl           String?
  faviconUrl             String?
  /// Prefixo das demandas (padrão DEM). Nenhuma sigla de cliente pode ser igual a ele.
  demandPrefix           String   @default("DEM")
  clientCodeMask         String   @default("{SIGLA}-{SEQ:3}")
  demandCodeMask         String   @default("{PREFIXO}-{SEQ:4}")
  /// Modelo da mensagem de cobrança via WhatsApp (D-38), com variáveis {{...}}.
  billingMessageTemplate String   @default("Olá, {{contato_financeiro.nome}}. Lembrete: a cobrança de {{servico}} do {{cliente.nome}} vence em {{vencimento}}. Qualquer dúvida, estamos à disposição. Equipe {{instancia.nome}}")
  /// Palavras ignoradas ao sugerir a sigla do cliente.
  ignoredWords           String[] @default(["Hotel", "Pousada", "Resort", "de", "do", "dos", "da", "das", "e"])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}

/// Imagens enviadas pelo sistema (D-89): logos, favicon e fotos de perfil, até 512 KB.
model Asset {
  id           String   @id @default(cuid())
  data         Bytes
  contentType  String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("assets")
}

/// Catálogo da instância: canais de venda, Channel Managers, PMS e serviços internos (white-label).
model CatalogItem {
  id               String            @id @default(cuid())
  name             String
  logoUrl          String?
  extranetUrl      String?
  /// Acesso pela conta da empresa (D-104): sem usuário e senha; o Cofre guarda só o link da página da propriedade.
  companyAccount   Boolean           @default(false)
  /// Categorias do item, cada uma com sua ordem (D-103).
  categories       CatalogItemCategory[]
  /// Arquivado (D-88): some das listas, continua nos clientes que já usam.
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  asChannelManager Client[]          @relation("ClientChannelManager")
  asPms            Client[]          @relation("ClientPms")
  credentials      VaultCredential[]
  demands          Demand[]
  deployments      ChannelDeployment[]

  @@map("catalog_items")
}

/// Categoria de um item do catálogo e a posição dele nela (ordem das colunas na Matriz e no Cofre).
model CatalogItemCategory {
  itemId   String
  /// "canal" | "channel_manager" | "pms" | "servico_interno"
  category String
  position Int         @default(0)
  item     CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, category])
  @@index([category, position])
  @@map("catalog_item_categories")
}

/// Cliente / estabelecimento (clientes-design-v2.md). Status é calculado pelos serviços (D-26), nunca guardado.
model Client {
  id               String            @id @default(cuid())
  /// Código legível imutável (#HFI-001), gerado pelo gerador de IDs.
  displayCode      String            @unique
  sigla            String
  name             String
  logoUrl          String?
  city             String?
  /// UF (duas letras).
  state            String?
  website          String?
  channelManagerId String?
  pmsId            String?
  /// Contato principal: "pessoa" (nome + telefone) ou "grupo" (nome + link do grupo de WhatsApp).
  contactType      String?
  contactName      String?
  contactPhone     String?
  contactLink      String?
  /// Contato financeiro (cobrança via WhatsApp).
  financeName      String?
  financePhone     String?
  /// Aviso importante (faixa âmbar no cabeçalho da ficha).
  notice           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  channelManager   CatalogItem?      @relation("ClientChannelManager", fields: [channelManagerId], references: [id])
  pms              CatalogItem?      @relation("ClientPms", fields: [pmsId], references: [id])
  services         ClientService[]
  credentials      VaultCredential[]
  demands          Demand[]
  checklist        ClientChecklist?
  deployments      ChannelDeployment[]

  @@index([name])
  @@map("clients")
}

/// Serviço contratado por um cliente, com a própria fase (D-14).
model ClientService {
  id         String    @id @default(cuid())
  clientId   String
  serviceId  String
  phase      String
  /// Contínuos: dia do mês do vencimento (1 a 31).
  billingDay Int?
  /// Pontuais: data única de vencimento.
  dueDate    DateTime? @db.Date
  startedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service    Service   @relation(fields: [serviceId], references: [id])

  @@index([clientId])
  @@map("client_services")
}

/// Acesso de um canal no Cofre (seguranca-e-cofre.md): usuário e senha cifrados (AES-256-GCM + key_version).
model VaultCredential {
  id            String      @id @default(cuid())
  clientId      String
  catalogItemId String
  /// Rótulo opcional quando o canal tem mais de um acesso (ex.: "Conta 2").
  label         String?
  propertyId    String?
  /// { ciphertext, iv, authTag, keyVersion }. Vazio nos acessos pela conta da empresa (D-104).
  username      Json?
  /// { ciphertext, iv, authTag, keyVersion }. Vazio nos acessos pela conta da empresa (D-104).
  password      Json?
  /// Extranet própria deste acesso; nos acessos pela conta da empresa, o link da página da propriedade.
  extranetUrl   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([clientId])
  @@map("vault_credentials")
}

/// Demanda (demandas-spec.md, D-95 a D-102). Código gerado pelo sistema (DEM-0042). Nunca é apagada (D-95).
model Demand {
  id                String             @id @default(cuid())
  displayCode       String             @unique
  title             String
  /// Documento do editor (formato estruturado, nunca HTML) — D-96.
  description       Json?
  /// "a_fazer" | "em_andamento" | "aguardando_retorno" | "concluida" | "cancelada" (D-99)
  status            String             @default("a_fazer")
  /// "normal" | "alta" | "critica" (D-101)
  priority          String             @default("normal")
  dueDate           DateTime?          @db.Date
  /// "HH:MM" quando o prazo tem hora.
  dueTime           String?
  clientId          String?
  platformId        String?
  /// Aprovação coletiva: Concluir só depois de todos confirmarem a parte.
  requireAllConfirm Boolean            @default(false)
  createdById       String
  completedAt       DateTime?
  completedById     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  client            Client?            @relation(fields: [clientId], references: [id])
  platform          CatalogItem?       @relation(fields: [platformId], references: [id])
  createdBy         User               @relation("DemandCreator", fields: [createdById], references: [id])
  completedBy       User?              @relation("DemandCompleter", fields: [completedById], references: [id])
  assignees         DemandAssignee[]
  subtasks          DemandSubtask[]
  attachments       DemandAttachment[]
  events            DemandEvent[]

  @@index([status])
  @@index([clientId])
  @@map("demands")
}

/// Pessoa atribuída: "visto às" (primeira abertura) e "confirmou minha parte".
model DemandAssignee {
  demandId    String
  userId      String
  seenAt      DateTime?
  confirmedAt DateTime?
  demand      Demand    @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@id([demandId, userId])
  @@index([userId])
  @@map("demand_assignees")
}

model DemandSubtask {
  id       String  @id @default(cuid())
  demandId String
  text     String
  done     Boolean @default(false)
  position Int     @default(0)
  demand   Demand  @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([demandId])
  @@map("demand_subtasks")
}

/// Anexo do Google Drive: só o link (D-68).
model DemandAttachment {
  id        String   @id @default(cuid())
  demandId  String
  url       String
  name      String
  mimeType  String?
  addedById String
  createdAt DateTime @default(now())
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  addedBy   User     @relation(fields: [addedById], references: [id])

  @@index([demandId])
  @@map("demand_attachments")
}

/// Linha do tempo: comentários e alterações (D-69).
model DemandEvent {
  id        String   @id @default(cuid())
  demandId  String
  /// "criacao" | "comentario" | "alteracao"
  kind      String
  authorId  String
  /// Comentário (documento do editor).
  body      Json?
  /// Alterações: [{ field, from, to }] em texto pronto para exibir.
  changes   Json?
  createdAt DateTime @default(now())
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([demandId, createdAt])
  @@map("demand_events")
}

/// Serviços contratáveis (D-15). Nome editável; tipo e fases são regras do produto (fases só leitura na Fase 1).
model Service {
  /// Código interno estável: cadastro_revisao, consultoria, assessoria, central_reservas.
  id        String          @id
  name      String
  /// "pontual" | "continuo"
  kind      String
  phases    String[]
  position  Int
  updatedAt DateTime        @updatedAt
  clients   ClientService[]

  @@map("services")
}

/// Contadores dos códigos legíveis, um por tipo de entidade e escopo (sigla do cliente ou "global").
model IdSequence {
  entityType String
  scope      String
  lastValue  Int    @default(0)

  @@id([entityType, scope])
  @@map("id_sequences")
}

/// Trava de edição: no máximo uma linha por registro (o primeiro a gravar vence).
model EditLock {
  entityType      String
  entityId        String
  userId          String
  acquiredAt      DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId])
  @@index([userId])
  @@map("edit_locks")
}

/// Caixa de entrada (D-83): avisos para cada pessoa, entregues em tempo real.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  /// Aba que abre ao clicar (tipo e parâmetros), ex.: { "kind": "demandas" }.
  target    Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// --- Login (Better Auth: e-mail, senha, Google Authenticator e perfis). Gerado pela ferramenta "auth generate". ---

model User {
  id                    String         @id
  name                  String
  email                 String
  /// Nome de usuário para entrar (D-85): minúsculas, números e ponto, único.
  username              String?        @unique
  emailVerified         Boolean        @default(false)
  image                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  twoFactorEnabled      Boolean?       @default(false)
  role                  String?
  banned                Boolean?       @default(false)
  banReason             String?
  banExpires            DateTime?
  mustChangePassword    Boolean?       @default(false)
  tempPasswordExpiresAt DateTime?
  sessions              Session[]
  accounts              Account[]
  twofactors            TwoFactor[]
  editLocks             EditLock[]
  notifications         Notification[]
  demandsCreated        Demand[]           @relation("DemandCreator")
  demandsCompleted      Demand[]           @relation("DemandCompleter")
  demandAssignments     DemandAssignee[]
  demandEvents          DemandEvent[]
  demandAttachments     DemandAttachment[]
  noticesCreated        InstanceNotice[]
  noticeReads           InstanceNoticeRead[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// Checklist de Onboarding Hoteleiro em 10 módulos operacionais.
model ClientChecklist {
  id              String   @id @default(cuid())
  clientId        String   @unique
  status          String   @default("rascunho") // "rascunho" | "em_revisao" | "aprovado"
  progressPercent Int      @default(0)
  data            Json     @default("{}")
  fieldMeta       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("client_checklists")
}

/// Situação do canal para um cliente na Matriz e Fila de Cadastros.
model ChannelDeployment {
  id            String      @id @default(cuid())
  clientId      String
  catalogItemId String
  /// "nao_contratado" | "a_cadastrar" | "em_andamento" | "feito_pelo_channel_manager" | "no_ar"
  status        String      @default("a_cadastrar")
  bottleneck    String?
  priority      String      @default("normal") // "normal" | "alta" | "critica"
  deadline      DateTime?   @db.Date
  notes         String?
  liveAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([clientId, catalogItemId])
  @@index([clientId])
  @@index([status])
  @@map("channel_deployments")
}

/// Mural de avisos pontuais publicados pelo Administrador (Início / Dashboard).
model InstanceNotice {
  id         String               @id @default(cuid())
  text       String
  authorId   String
  authorName String
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())
  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads      InstanceNoticeRead[]

  @@index([createdAt])
  @@map("instance_notices")
}

/// Registro de ciência ("Ciente") de um aviso por usuário.
model InstanceNoticeRead {
  noticeId String
  userId   String
  readAt   DateTime       @default(now())
  notice   InstanceNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
  @@map("instance_notice_reads")
}

