// Estrutura do banco. Cada mudança aqui vira uma migração (prisma/migrations) aplicada com segurança.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Configurações da instância (white-label): nome, logos e formatos de código vêm daqui, nunca do código.
model InstanceSettings {
  id                     String   @id @default("instancia")
  name                   String
  logoDarkUrl            String?
  logoLightUrl           String?
  faviconUrl             String?
  /// Prefixo das demandas (padrão DEM). Nenhuma sigla de cliente pode ser igual a ele.
  demandPrefix           String   @default("DEM")
  clientCodeMask         String   @default("{SIGLA}-{SEQ:3}")
  demandCodeMask         String   @default("{PREFIXO}-{SEQ:4}")
  /// Modelo da mensagem de cobrança via WhatsApp (D-38), com variáveis {{...}}.
  billingMessageTemplate String   @default("Olá, {{contato_financeiro.nome}}. Lembrete: a cobrança de {{servico}} do {{cliente.nome}} vence em {{vencimento}}. Qualquer dúvida, estamos à disposição. Equipe {{instancia.nome}}")
  /// Palavras ignoradas ao sugerir a sigla do cliente.
  ignoredWords           String[] @default(["Hotel", "Pousada", "Resort", "de", "do", "dos", "da", "das", "e"])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}

/// Imagens enviadas pelo sistema (D-89): logos, favicon e fotos de perfil, até 512 KB.
model Asset {
  id           String   @id @default(cuid())
  data         Bytes
  contentType  String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("assets")
}

/// Catálogo da instância: canais de venda, Channel Managers, PMS e serviços internos (white-label).
model CatalogItem {
  id               String            @id @default(cuid())
  /// "canal" | "channel_manager" | "pms" | "servico_interno"
  category         String
  name             String
  logoUrl          String?
  extranetUrl      String?
  /// Ordem das colunas na Matriz de Cadastros e no Cofre.
  position         Int               @default(0)
  /// Arquivado (D-88): some das listas, continua nos clientes que já usam.
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  asChannelManager Client[]          @relation("ClientChannelManager")
  asPms            Client[]          @relation("ClientPms")
  credentials      VaultCredential[]

  @@index([category, position])
  @@map("catalog_items")
}

/// Cliente / estabelecimento (clientes-design-v2.md). Status é calculado pelos serviços (D-26), nunca guardado.
model Client {
  id               String            @id @default(cuid())
  /// Código legível imutável (#HFI-001), gerado pelo gerador de IDs.
  displayCode      String            @unique
  sigla            String
  name             String
  logoUrl          String?
  city             String?
  /// UF (duas letras).
  state            String?
  website          String?
  channelManagerId String?
  pmsId            String?
  /// Contato principal: "pessoa" (nome + telefone) ou "grupo" (nome + link do grupo de WhatsApp).
  contactType      String?
  contactName      String?
  contactPhone     String?
  contactLink      String?
  /// Contato financeiro (cobrança via WhatsApp).
  financeName      String?
  financePhone     String?
  /// Aviso importante (faixa âmbar no cabeçalho da ficha).
  notice           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  channelManager   CatalogItem?      @relation("ClientChannelManager", fields: [channelManagerId], references: [id])
  pms              CatalogItem?      @relation("ClientPms", fields: [pmsId], references: [id])
  services         ClientService[]
  credentials      VaultCredential[]

  @@index([name])
  @@map("clients")
}

/// Serviço contratado por um cliente, com a própria fase (D-14).
model ClientService {
  id         String    @id @default(cuid())
  clientId   String
  serviceId  String
  phase      String
  /// Contínuos: dia do mês do vencimento (1 a 31).
  billingDay Int?
  /// Pontuais: data única de vencimento.
  dueDate    DateTime? @db.Date
  startedAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service    Service   @relation(fields: [serviceId], references: [id])

  @@index([clientId])
  @@map("client_services")
}

/// Acesso de um canal no Cofre (seguranca-e-cofre.md): usuário e senha cifrados (AES-256-GCM + key_version).
model VaultCredential {
  id            String      @id @default(cuid())
  clientId      String
  catalogItemId String
  /// Rótulo opcional quando o canal tem mais de um acesso (ex.: "Conta 2").
  label         String?
  propertyId    String?
  /// { ciphertext, iv, authTag, keyVersion }
  username      Json
  /// { ciphertext, iv, authTag, keyVersion }
  password      Json
  extranetUrl   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([clientId])
  @@map("vault_credentials")
}

/// Serviços contratáveis (D-15). Nome editável; tipo e fases são regras do produto (fases só leitura na Fase 1).
model Service {
  /// Código interno estável: cadastro_revisao, consultoria, assessoria, central_reservas.
  id        String          @id
  name      String
  /// "pontual" | "continuo"
  kind      String
  phases    String[]
  position  Int
  updatedAt DateTime        @updatedAt
  clients   ClientService[]

  @@map("services")
}

/// Contadores dos códigos legíveis, um por tipo de entidade e escopo (sigla do cliente ou "global").
model IdSequence {
  entityType String
  scope      String
  lastValue  Int    @default(0)

  @@id([entityType, scope])
  @@map("id_sequences")
}

/// Trava de edição: no máximo uma linha por registro (o primeiro a gravar vence).
model EditLock {
  entityType      String
  entityId        String
  userId          String
  acquiredAt      DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId])
  @@index([userId])
  @@map("edit_locks")
}

/// Caixa de entrada (D-83): avisos para cada pessoa, entregues em tempo real.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String?
  /// Aba que abre ao clicar (tipo e parâmetros), ex.: { "kind": "demandas" }.
  target    Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/// Registro de teste da Etapa 1.0: prova do tempo real e da trava em /dev/tempo-real.
model RealtimeProbe {
  id          String   @id @default("teste")
  text        String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("realtime_probe")
}

// --- Login (Better Auth: e-mail, senha, Google Authenticator e perfis). Gerado pela ferramenta "auth generate". ---

model User {
  id                    String         @id
  name                  String
  email                 String
  /// Nome de usuário para entrar (D-85): minúsculas, números e ponto, único.
  username              String?        @unique
  emailVerified         Boolean        @default(false)
  image                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  twoFactorEnabled      Boolean?       @default(false)
  role                  String?
  banned                Boolean?       @default(false)
  banReason             String?
  banExpires            DateTime?
  mustChangePassword    Boolean?       @default(false)
  tempPasswordExpiresAt DateTime?
  sessions              Session[]
  accounts              Account[]
  twofactors            TwoFactor[]
  editLocks             EditLock[]
  notifications         Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
